# ============ 基础配置 ============
# Windows 默认字体；Linux/macOS 请按环境修改
# 兼容旧版设置；文案由页面选择模型，海报由 POSTER_MODE 决定，视频本地合成
MOCK_MODE=true

# 数据库连接（默认 SQLite；以后切换 PostgreSQL 只需改这里，例如：
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/promo）
DATABASE_URL=sqlite:///./data/promo.db

# 文件存储目录（相对 backend 目录或绝对路径）
UPLOAD_DIR=../uploads
OUTPUT_DIR=../outputs

# 上传限制（MB）
MAX_UPLOAD_MB=10

# FFmpeg 可执行文件路径（默认从 PATH 查找）
FFMPEG_PATH=ffmpeg

# 海报/视频中文字体路径（macOS 默认已有，Linux 请改为 Noto Sans CJK 等字体路径）
FONT_PATH=C:/Windows/Fonts/msyh.ttc

# 视频生成
VIDEO_API_KEY=
VIDEO_BASE_URL=

# 海报独立配置：local 为本地模板；ai 使用 /images/edits
POSTER_MODE=local
POSTER_MODEL=
POSTER_SIZE=1024x1536

# 文案生成（可选 OpenAI-compatible 兼容服务）
COPYWRITING_API_KEY=
COPYWRITING_BASE_URL=
COPYWRITING_MODEL=

# 海报/视觉生成（可选 OpenAI-compatible 兼容服务）
POSTER_API_KEY=
POSTER_BASE_URL=

# ============ Google AI Studio / Gemini Developer API（仅后端；默认关闭）============
# Key 只放在 backend/.env，绝不要提交、截图或使用 NEXT_PUBLIC_*。
GOOGLE_API_KEY=
GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_API_VERSION=v1beta
GOOGLE_TEXT_MODEL=gemini-2.5-flash
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_TEXT_ENABLED=false
GOOGLE_TEXT_COST_APPROVED=false
GOOGLE_IMAGE_ENABLED=false
GOOGLE_IMAGE_COST_APPROVED=false
GOOGLE_VIDEO_ENABLED=false
# Keep false until the user explicitly approves Veo costs.
GOOGLE_VIDEO_COST_APPROVED=false
GOOGLE_TTS_ENABLED=false
GOOGLE_TTS_COST_APPROVED=false
GOOGLE_SDK_TIMEOUT_SECONDS=180
GOOGLE_VIDEO_TIMEOUT_SECONDS=480
GOOGLE_VIDEO_DURATION_SECONDS=8
# Production safeguard: Veo requests require an explicit per-request ceiling.
GOOGLE_VIDEO_MAX_COST_USD=1.0
GOOGLE_POLL_SECONDS=10
GOOGLE_TTS_VOICE=Aoede
GOOGLE_TTS_LANGUAGE=zh-CN
MAX_TTS_CHARS=4000

# ============ Alibaba Cloud Model Studio / Bailian ============
# Only use a normal Model Studio API key. Coding Plan keys beginning sk-ws-
# are rejected by the application. Keep this file uncommitted after copying it
# to backend/.env; never expose any key through NEXT_PUBLIC_* variables.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
# Leave empty to derive the workspace endpoint from Workspace ID + region.
DASHSCOPE_BASE_URL=
BAILIAN_TEXT_MODEL=qwen3.8-flash
BAILIAN_IMAGE_MODEL=wan2.7-image
BAILIAN_I2V_MODEL=wan2.7-i2v
BAILIAN_T2V_MODEL=wan2.7-t2v
BAILIAN_TTS_MODEL=qwen-audio-3.1-tts-flash
BAILIAN_TTS_VOICE=longanhuan_v3.1
BAILIAN_TEXT_ENABLED=true
BAILIAN_IMAGE_ENABLED=true
BAILIAN_VIDEO_ENABLED=true
BAILIAN_TTS_ENABLED=true
# Each capability stays blocked until the user explicitly approves costs.
BAILIAN_TEXT_COST_APPROVED=false
BAILIAN_IMAGE_COST_APPROVED=false
BAILIAN_VIDEO_COST_APPROVED=false
BAILIAN_TTS_COST_APPROVED=false
BAILIAN_VIDEO_DURATION_SECONDS=5
BAILIAN_VIDEO_RESOLUTION=720P
