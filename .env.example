# Copy to .env.local and fill in your provider credentials.
# The key stays on the server: never prefix these with NEXT_PUBLIC_.
AI_BASE_URL=https://api.openai-next.com
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o
AI_VISION_MODEL=gpt-4o
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_ENABLED=off
AI_TEXT_COST_APPROVED=false
AI_IMAGE_COST_APPROVED=false
# Gemini: set GEMINI_API_KEY to select Gemini automatically, or set AI_PROVIDER=gemini.
# Gemini uses its own model settings independently of the compatible provider above.
# GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_VISION_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_ENABLED=true
# Paid image generation requires explicit cost approval. Keep false until approved.
# GEMINI_IMAGE_PAID_APPROVED=false
# Veo requires model access and billing on the Google project.
# GEMINI_VIDEO_ENABLED=true
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# GEMINI_VIDEO_TIMEOUT_MS=480000
# off = deterministic local demo, no network calls
MORPHSITE_AI=on
# MorphSite only proxies the marketing backend; this is not a secret.
MARKETING_BACKEND_URL=http://127.0.0.1:8002

# Use the FastAPI Bailian provider for site generation. The DashScope key stays
# only in integrations/hackathon-mvp/backend/.env.
AI_PROVIDER=bailian
BAILIAN_TEXT_MODEL=qwen3.8-flash
BAILIAN_IMAGE_MODEL=wan2.7-image
BAILIAN_I2V_MODEL=wan2.7-i2v

# Optional Gemini settings used by Next.js. start-marketing.py passes approved
# capabilities to FastAPI when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_ENABLED=false
GEMINI_TEXT_COST_APPROVED=false
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_COST_APPROVED=false
GEMINI_TTS_ENABLED=false
GEMINI_TTS_COST_APPROVED=false
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# All three switches are required before Next.js can call a paid video model.
GEMINI_VIDEO_ENABLED=false
GEMINI_VIDEO_COST_APPROVED=false
GEMINI_VIDEO_MAX_COST_USD=0

# Set only after deploying the app to an externally reachable HTTPS domain.
# Leave empty during local development: publishing is explicitly unavailable.
PUBLIC_SITE_URL=
# Persistent disk folder; preserve across deployments/backups.
# Serverless deployments need a persistent store before publishing can work.
MORPHSITE_PUBLISH_DIR=
# Production default is on. It performs one bounded DNS/TLS/HTTP check before
# publication and verifies the final /s/{slug} URL before reporting success.
MORPHSITE_PUBLIC_PROBE=on
